pipeline {
    agent any

    options {
        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '10'
        ))
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    triggers {
        githubPush()
    }

    environment {
        DOCKER_BUILDKIT = '1'

        GITHUB_CREDS = credentials('github-creds')
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials-id')

        INFISICAL_CLIENT_ID = credentials('INFISICAL_CLIENT_ID')
        INFISICAL_CLIENT_SECRET = credentials('INFISICAL_CLIENT_SECRET')
        INFISICAL_URL = 'https://secret.tapfin.in'
        INFISICAL_PROJECT_ID = '1c8820db-4f94-47de-b887-0a2684f1cd8d'
        INFISICAL_ENV = 'flexprice-front-uat'

        TARGET_SERVER = 'root@187.127.165.207'
        SSH_PORT = '4005'

        IMAGE_NAME = 'tapfin/flexprice-front-uat'
        CONTAINER_NAME = 'flexprice-front-uat'
        APP_PORT = '3021'
    }

    stages {

        stage('Checkout Source') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/tapfin-tech/flexprice-front.git'
                )
            }
        }

        stage('Fetch Settings') {
            steps {
                sh '''
                    set +x

                    echo "Login Infisical"

                    export INFISICAL_TOKEN=$(infisical login \
                        --method=universal-auth \
                        --client-id=$INFISICAL_CLIENT_ID \
                        --client-secret=$INFISICAL_CLIENT_SECRET \
                        --domain=$INFISICAL_URL \
                        --plain \
                        --silent)

                    infisical export \
                        --projectId=$INFISICAL_PROJECT_ID \
                        --env=$INFISICAL_ENV \
                        --domain=$INFISICAL_URL \
                        --token=$INFISICAL_TOKEN \
                        --format=json > secrets.json

                    python3 <<'EOF'
import json

with open("secrets.json") as f:
    data=json.load(f)

with open(".env","w") as env:
    if isinstance(data,list):
        for item in data:
            key=item.get("key")
            value=str(item.get("value",""))
            value=value.replace("\\n","\\\\n")
            env.write(f"{key}={value}\\n")
    else:
        for key,value in data.items():
            value=str(value)
            value=value.replace("\\n","\\\\n")
            env.write(f"{key}={value}\\n")
EOF

                    rm -f secrets.json
                    echo "Settings Loaded"
                    wc -l .env
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker pull $IMAGE_NAME:latest || true

                    docker build \
                        -f deploy/uat/Dockerfile \
                        --cache-from $IMAGE_NAME:latest \
                        -t $IMAGE_NAME:$BUILD_NUMBER \
                        -t $IMAGE_NAME:latest .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId:'dockerhub-credentials-id',
                        url:'https://index.docker.io/v1/'
                    ) {
                        sh '''
                            docker push $IMAGE_NAME:$BUILD_NUMBER
                            docker push $IMAGE_NAME:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy to Server') {
            steps {
                sshagent(credentials:['ghostnode-server']) {
                    sh '''
                        ssh -p $SSH_PORT -o StrictHostKeyChecking=no $TARGET_SERVER "
                            set -e
                            docker pull $IMAGE_NAME:$BUILD_NUMBER
                            docker rm -f $CONTAINER_NAME || true

                            docker run -d \
                                --name $CONTAINER_NAME \
                                --restart unless-stopped \
                                --log-opt max-size=20m --log-opt max-file=3 \
                                -p $APP_PORT:8080 \
                                $IMAGE_NAME:$BUILD_NUMBER

                            for i in \\$(seq 1 15); do
                                curl -fsS http://127.0.0.1:$APP_PORT/healthz >/dev/null && break
                                [ \\$i -eq 15 ] && docker logs --tail 50 $CONTAINER_NAME && exit 1
                                sleep 2
                            done

                            docker ps --filter name=$CONTAINER_NAME
                            docker image prune -af --filter 'until=48h' >/dev/null || true
                        "
                    '''
                }
            }
        }

    }   // closes stages

    post {
        always {
            sh 'rm -f .env'
            cleanWs()
        }

        success {
            echo "Deployment Successful Build ${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline Failed Build ${BUILD_NUMBER}"
        }
    }
}
