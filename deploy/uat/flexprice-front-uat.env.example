# Flexprice dashboard, UAT.
# Load these into Infisical (env slug: flexprice-front-uat). They are baked into the
# JavaScript bundle at build time and visible to every visitor: never put secrets here.

# self-hosted = backend login, and PostHog / Vercel / Supabase stay off.
VITE_APP_ENV=self-hosted
VITE_API_URL=https://<billing-uat-api-domain>/v1
VITE_AUTH_PROVIDER=flexprice
VITE_WEBHOOK_PROVIDER=flexprice

VITE_POSTHOG_ENABLED=false
VITE_PADDLE_ENABLED=false
VITE_INTERCOM_ENABLED=false
VITE_PYLON_ENABLED=false
VITE_REO_ENABLED=false
